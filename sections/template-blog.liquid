{% liquid
    assign posts_per_page = section.settings.number_of_blog_posts
    assign show_description = section.settings.show_description
 %}

{% paginate blog.articles by posts_per_page %}
    {% for article in blog.articles %}
        <div class="blog-element">
            {% if article.image %}
                <img src="{{article.image |  image_url: width: 250}}" alt="{{article.image.alt}}" />
            {% else %}
                 {{ 'image' |  placeholder_svg_tag: 'w-20'    }}
            {% endif %}
            <h1>{{article.title }}</h1>
            {% if article.excerpt.size > 0 %}
                <p>{{ article.excerpt }}</p>
            {% else %}
                {% if show_description %}
                    <p>{{ article.content | strip_html | truncatewords: 15 }}</p>
                {% endif %}
            {% endif %}
        </div>
    {% endfor %}
{% endpaginate %}

{% schema %}
{
    "name": "Blog",
    "settings": [
            {
                "type": "range",
                "id": "number_of_blog_posts",
                "step": 1,
                "min": 1,
                "max": 6,
                "label": "Blog posts per page",
                "default": 3
            },
            {
                "type": "checkbox",
                "id": "show_description",
                "label": "Show description of a blog",
                "default": true
                }
        ]
}
{% endschema %}