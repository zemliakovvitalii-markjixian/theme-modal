{% liquid
    assign posts_per_page = section.settings.number_of_blog_posts
    assign show_description = section.settings.show_description
 %}

 <div class="py-4">
     {% paginate blog.articles by posts_per_page %}

        <h1 class="text-center text-3xl">{{blog.title}}</h1>
        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {% for article in blog.articles %}
                    <div class="py-6 px-3">
                        <div class="bg-white shadow-xl rounded-lg overflow-hidden">
                            {% if article.image %}
                                <a href="{{article.url}}">
                                    <img class="w-full h-80 object-cover"  src="{{article.image |  image_url: width: 250}}" alt="{{article.image.alt}}" />
                                </a>
                            {% else %}
                                {{ 'image' |  placeholder_svg_tag: 'w-full h-80 object-cover bg-gray-100' }}
                            {% endif %}

                            <div class="content flex flex-col gap-3 p-3">
                                <h1 class="text-xl font-medium">{{article.title }}</h1>

                                {% if article.excerpt.size > 0 %}
                                    <p>{{ article.excerpt | strip_html }}</p>
                                {% else %}
                                    {% if show_description %}
                                        <p>{{ article.content | strip_html | truncatewords: 15 }}</p>
                                    {% endif %}
                                {% endif %}

                                <a class="font-medium text-blue-600 hover:text-blue-800" href="{{article.url}}">{{section.settings.read_more_text}}</a>
                            </div>

                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="max-w-6xl mx-auto">
            {% render 'pagination', paginate: paginate %}
        </div>

     {% endpaginate %}
 </div>


{% schema %}
{
    "name": "Blog",
    "settings": [
            {
                "type": "range",
                "id": "number_of_blog_posts",
                "step": 1,
                "min": 1,
                "max": 6,
                "label": "Blog posts per page",
                "default": 1
            },
            {
                "type": "checkbox",
                "id": "show_description",
                "label": "Show description of a blog",
                "default": true
            },
            {
                "type": "text",
                "id": "read_more_text",
                "label": "Text for a card",
                "default": "Read more"
            }
        ]
}
{% endschema %}