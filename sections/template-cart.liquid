{% if cart.item_count > 0 %}
        <div class="p-4 max-w-6x">

            <div class="flex flex-col my-10 mx-auto">
                <div class="flex items-end justify-between my-5">
                    <h1 class="text-3xl">Your cart</h1>
                    <a href="" class="text-blue-600 hover:text-blue-800 font-medium underline">Continue shopping</a>
                </div>
            </div>

            <div class="flex flex-col my-10 mx-auto">
                <form action="{{routes.cart_url}}" method="post" novalidate>
                    <table class="table-auto divide-y divide-gray-200 my-4 w-full">
                        <thead>
                            <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Product</th>
                            <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Qty</th>
                            <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Total Price</th>
                        </thead>
                        <tbody>
                        {% for item in cart.items %}
                            <tr class="table-row">
                                <td class="px-2 py-4 flex flex-col justify-center">
                                    <a href="{{item.url}}">
                                        {% if item.image %}
                                            <img src="{{item.image |  image_url: width: 250}}" alt="{{item.title | escape}}" class="w-20 h-20 object-cover" />
                                        {% else %}
                                            {{'product-1' |  placeholder_svg_tag: 'w-20 h-20 object-cover border'}}
                                        {% endif %}
                                    </a>
                                </td>
                                <td class="px-2 py-4 flex flex-col justify-center">
                                    <a href="{{item.url}}" class="my-1">{{ item.product.title |  truncatewords: 5 }}</a>
                                        <span class="text-sm text-gray-500 my-1">{{item.variant.title}}</span>
                                    <a href="{{routes.cart_change_url}}?line={{forloop.index}}&quantity=0" class="text-sm font-medium text-red-500 my-1">Remove</a>
                                </td>
                                <td class="py-4 px-2">
                                    <input type="number" name="updates[]" min="1" id="updates_{{forloop.index}}" value="{{item.quantity}}" class="w-20 border p-2">
                                </td>
                                <td class="py-4 px-2">
                                    {{item.line_price |  money_with_currency}}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    <div class="flex flex-col md:flex-row items-start justify-between">
                        <div class="w-full">
                            <div class="flex flex-col items-start">
                                <label for="cart_notes" class="my-1">Cart notes</label>
                                <textarea name="note" id="cart_notes" class="w-full md:max-w-lg resize-none border h-20"></textarea>
                            </div>
                        </div>

                        <div class="w-full md:w-80">
                            {% for block in section.blocks %}
                                {% case block.type %}
                                    {% when 'subtotal' %}
                                         <h3 class="text-xl">Subtotal: {{cart.total_price |  money}}</h3>
                                    {% when 'update_button' %}
                                        <div class="my-2">
                                            <button name="update" type="submit" class="w-full p-3 border border-gray-600 text-gray-600 font-medium hover:bg-gray-600 hover:text-white">Update</button>
                                        </div>
                                    {% when 'checkout_button' %}
                                        <div class="my-2">
                                            <button name="checkout" type="submit" class="w-full p-3 border border-gray-600 font-medium bg-gray-600 text-white">Checkout</button>
                                        </div>
                                {% endcase %}
                            {% endfor %}

                        </div>
                    </div>
                </form>
            </div>

        </div>
{% else %}
        <div class="max-w-6xl h-60 my-4 mx-auto flex flex-center">
            <div class="text-center">
                <h1 class="text-3xl my-4">Your cart is empty</h1>
                <div class="my-4 py-4">
                    <a href="{{routes.all_products_collection_url}}" class="border border-gray-600 text-white bg-gray-600 px-8 py-3">
                        Continue shopping
                    </a>
                </div>
            </div>
        </div>
{% endif %}

{% schema %}
{
    "name": "Template Cart",
    "blocks": [
        {
            "type": "subtotal",
            "name": "Subtotal",
            "limit": 1
        },
        {
            "type": "update_button",
            "name": "Update Button",
            "limit": 1
        },
        {
            "type": "checkout_button",
            "name": "Checkout Button",
            "limit": 1
        }
    ]
}
{% endschema %}