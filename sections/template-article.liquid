<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ article.url | prepend: shop.url }}"
  },
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | truncate: 200 | json }},
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
  "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }}
  }
  {%- if article.image -%}
  ,"image": {
    "@type": "ImageObject",
    "url": "{{ article.image | image_url: width: 1200 }}",
    "width": 1200,
    "height": {{ 1200 | times: article.image.height | divided_by: article.image.width }}
  }
  {%- endif -%}
}
</script>

<article itemscope itemtype="https://schema.org/BlogPosting" class="py-8 grid place-items-center gap-y-2 px-2 md:px-1 lg:px-0">
    {% for block in section.blocks %}
        {% case block.type %}
            {% when 'article_title' %}
                <div class="grid place-items-center">
                        <a href="{{blog.url}}" class="text-base uppercase text-gray-500 hover:text-gray-900 font-bold">{{blog.title}}</a>
                        <h1 class="text-4xl md:text-6xl font-medium" itemprop="headline">{{article.title}} </h1>
                </div>

            {% when 'article_author' %}
                {% if section.settings.enable_author %}
                    <div class="" itemscope itemtype="https://schema.org/Person">
                            <small itemprop="name">{{article.author}}</small>
                    </div>
                {% endif %}
            {% when 'article_published_date' %}
                {% if section.settings.enable_published_date %}
                    <div class="">
                            <time datetime="{{article.published_at |  date: '%B %d, %Y'}}">
                                {{article.published_at | date: format: 'on_date'}}
                            </time>
                    </div>
                {% endif %}
            {% when 'featured_img' %}
                <div class=" max-w-7xl w-full bg-blue-100 rounded-lg md:mx-auto overflow-hidden">
                    {% if article.image != blank %}
                        <img class="w-full h-80 md:h-96 object-cover object-center" src="{{article.image |  image_url: width: 1450 }}" alt="{{article.image.alt}}" loading="lazy"/>
                    {% else %}
                        {%  assign placeholder_image = 'lifestyle-1' %}
                        {{placeholder_image |  placeholder_svg_tag: 'w-full h-80 md:h-96 object-cover object-center p-5'}}
                    {% endif %}
                </div>

            {% when 'article_content' %}
                <div class="max-w-5xl">
                        {{article.content}}
                </div>
            {% else %}
        {% endcase %}
    {% endfor %}
</article>

{% if blog.comments_enabled? %}
    <div id="comments" class="mb-8 max-w-4xl w-full mx-auto">
        {% if article.comments_count > 0 %}
            <div class="grid gap-y-4 px-2">
                <h1 class="text-lg mb-4 font-medium">See what people are saying</h1>

                {% paginate article.comments by 5 %}
                    {% for comment in article.comments %}
                        <div class=" border leading-relaxed p-2 grid gap-y-1">
                            <span class="comment-author"><strong><i>Author</i> - </strong>{{comment.author}}</span>
                            <span class="text-xs text-gray-400"> <strong><i>Date</i> - </strong>{{comment.created_at |  date: format: 'default'}}</span>
                            <div class="text-sm flex gap-x-1"><strong><i>Content</i> - </strong>{{comment.content}}</div>
                        </div>
                    {% endfor %}
                    {% if paginate.pages > 1 %}
                        <div class="max-w-6xl mx-auto">
                            {% render 'pagination', paginate: paginate %}
                        </div>
                    {% endif %}
                {% endpaginate %}
            </div>
        {% else %}
            There are no comments in this article
        {% endif %}
    </div>
    <div id="comment_form" class="mb-8 max-w-4xl w-full mx-auto">
            {% render 'blog-form' %}
    </div>
{% endif %}


{% schema %}
    {
        "name": "Template Article",
        "settings": [
            {
                "type": "checkbox",
                "id": "enable_author",
                "default": true,
                "label": "Display author name"
            },
            {
                "type": "checkbox",
                "id": "enable_published_date",
                "default": true,
                "label": "Dasplay Published Date"
            }
        ],
        "blocks": [
            {
                "type": "article_title",
                "name": "Title",
                "limit": 1
            },
            {
                "type": "article_author",
                "name": "Author",
                "limit": 1
            },
            {
                "type": "article_published_date",
                "name": "Published Date",
                "limit": 1
            },
            {
                "type": "featured_img",
                "name": "Thumbnail",
                "limit": 1
            },
            {
                "type": "article_content",
                "name": "Content",
                "limit": 1
            }
        ]
    }
{% endschema %}{%- comment -%}

