<div class="max-w-md">
    <div class="text-5xl font-bold my-4">{{section.settings.title}}</div>
    <div class="my-4">
        <p class="text-base md:text-xl leading-normal">{{section.settings.subtext_title}}</p>
    </div>
    <div class="my-4">
        {% if section.settings.button_url == blank %}
            {%  assign shop_url = routes.root_url %}
        {% else %}
            {%  assign shop_url = section.settings.button_url %}
        {% endif %}
        <a href="{{shop_url}}" class="leading-normal text-blue-600 hover:underline">
            {{section.settings.button_title_back}}
        </a>
    </div>
</div>

{% schema %}
    {
        "name": "Template 404",
        "tag": "section",
        "class": "flex items-center justify-center text-center py-7 h-dvh",
        "settings": [
            {
                "type": "text",
                "id": "title",
                "default": "404",
                "label": "404 Heading Title"
            },
            {
                "type": "text",
                "id": "subtext_title",
                "default": "The page you're looking for is not this one",
                "label": "404 Subtext title"
            },
            {
                "type": "text",
                "id": "button_title_back",
                "default": "Back to Home page",
                "label": "Back to home button title"
            },
            {
                "type": "url",
                "id": "button_url",
                "label": "Button URL"
            }
        ]
    }
{% endschema %}