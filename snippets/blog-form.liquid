{% form 'new_comment', article %}
    {{ form.errors | default_errors }}
    <div class="grid gap-2 max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-2">
            <div class="grid gap-1">
                <label for="comment_author" class="text-gray-700 font-medium uppercase text-xs">Name</label>
                <input
                    type="text"
                    name="comment[author]"
                    id="comment_author"
                    class="w-full text-gray-700 border px-4 focus:outline-none"
                    placeholder="Jane Doe"
                    required
                />
            </div>
            <div class="grid gap-1">
                <label for="comment_email" class="text-gray-700 font-medium uppercase text-xs">Email</label>
                <input
                    type="email"
                    name="comment[email]"
                    id="comment_email"
                    class="w-full text-gray-700 border px-4 focus:outline-none"
                    placeholder="test@test.com"
                    required
                />
            </div>
        </div>
        <div class="grid gap-1">
            <label for="comment_body" class="text-gray-700 font-medium uppercase text-xs">Comment</label>
            <textarea
                name="comment[body]"
                id="comment_body"
                class="w-full text-gray-700 border focus:outline-none resize-none"
                required
            ></textarea>
        </div>
        <input
            type="submit"
            value="Post comment"
            class="cursor-pointer w-full border text-base font-medium text-white bg-gray-900 hover:bg-gray-500"
        />
    </div>
{% endform %}
