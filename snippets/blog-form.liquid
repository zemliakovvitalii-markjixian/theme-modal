{% form 'new_comment', article %}
    <div class="grid gap-4 px-2 sm:grid-cols-2 grid-cols-1">
        {% if form.errors or form.posted_successfully? %}
            <div class="form_errors md:col-span-full">
                {% if form.errors %}
                <div class="border p-5">
                    <div class="flex items-center w-full my-3">
                        <div class="text-red-500">
                            {% render 'icon-failed'%}
                        </div>
                        <div class="text-sm font-medium ml-3">
                            Oh no, your comment wasnt posted
                        </div>
                    </div>

                    <ul class="px-4 mb-3 ml-7 list-decimal">
                        {% for error in form.errors %}
                        <li>
                            <span>{{form.errors.messages[error]}}</span>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                {% elsif form.posted_successfully? %}
                <div class="flex gap-x-2 items-center">
                    <div class="text-green-500">
                        {% render 'icon-success' %}
                    </div>
                    <div class="text-sm font-medium ">Comment is posted successfully</div>
                </div>
                {% endif %}
            </div>
        {% endif %}

        <div class="md:col-span-1">
            <label for="comment_author" class="text-gray-700 font-medium uppercase text-xs mb-2">Name</label>
            <input
                type="text"
                name="comment[author]"
                id="comment_author"
                class="w-full text-gray-700 border py-r px-4 focus:outline-none"
                placeholder="Jane Doe"
                required
            />
        </div>
        <div class="md:col-start-2">
            <label for="comment_email" class="text-gray-700 font-medium uppercase text-xs mb-2">Email</label>
            <input
                type="email"
                name="comment[email]"
                id="comment_email"
                class="w-full text-gray-700 border py-r px-4 focus:outline-none"
                placeholder="test@test.com"
                required
            />
        </div>
        <div class="md:col-span-full">
            <label for="comment_body" class="text-gray-700 font-medium uppercase text-xs mb-2">Comment</label>
            <textarea
                name="comment[body]"
                id="comment_body"
                class="w-full text-gray-700 border focus:outline-none resize-none"
                required
            >
            </textarea>
        </div>
        <div class="md:col-span-full">
            <input
                type="submit"
                value="Post comment"
                class="py-1 cursor-pointer w-full border text-base font-medium text-white bg-gray-900 hover:bg-gray-500"
            />
        </div>
    </div>
{% endform %}