<header>
    <h2>{{ shop.name }}</h2>
    <ul>
        {% for link in linklists.main-menu.links -%}
        <li>{{ link.title | link_to: link.url }}</li>
        {%- endfor %}
    </ul>
    {% for collection in collections %}
    {{- collection.title | link_to: collection.url }}
    {% endfor %}
</header>