<h1 class="blog">Blog - {{blog.title}}</h1>


{% for article in blog.articles %}
<div>
    <a href="{{article.url}}">
        <div style="display: flex; align-items:center"><strong>Author - </strong>{{article.author}}</div>
        <div style="display: flex; align-items:center"><strong>Content - </strong> {{article.content}}</div>
        <div style="display: flex; align-items:center"><strong>Excerpt - </strong> {{article.excerpt}}</div>
        <div style="display: flex; align-items:center"><strong>Created - </strong>_at {{article.created_at}}</div>
    </a>
</div>
{% endfor %}