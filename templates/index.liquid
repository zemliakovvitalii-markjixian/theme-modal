<h2>{{ collections['frontpage'].title }}</h2>

{% for product in collections['frontpage'].products %}
{% comment %} <div class="prod">
    <pre>{{ product | json }}</pre>
</div> {% endcomment %}
<div class="prod">
    <a href="{{product.url}}">
        <img src="{{product.featured_image | image_url: width: 400}}" alt="">
        <span class="title">{{- product.title | link_to: product.url }}</span>
        <span class="price">{{- product.price | money_with_currency -}}</span>  
    </a>
</div>
{% endfor %}