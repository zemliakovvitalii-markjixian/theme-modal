<h2>{{ collections['frontpage'].title }}</h2>

{% for product in collections['frontpage'].products %}
{% comment %} <div class="prod">
    <pre>{{ product | json }}</pre>
</div> {% endcomment %}
<div class="prod">
    <img src="{{product.featured_image | image_url}}" alt="">
    {{- product.title | link_to: product.url }}
    {{- product.price -}}
</div>
{% endfor %}